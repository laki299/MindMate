{
  "expo": {
    "name": "MindMate",
    "slug": "mindmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindmate.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MindMate অডিও ও ভিডিও কলের জন্য মাইক্রোফোন প্রয়োজন",
        "NSCameraUsageDescription": "MindMate ভিডিও কলের জন্য ক্যামেরা প্রয়োজন"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F3FF"
      },
      "package": "com.mindmate.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-screen-capture",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "MindMate ভিডিও কলের জন্য ক্যামেরা প্রয়োজন",
          "microphonePermission": "MindMate অডিও ও ভিডিও কলের জন্য মাইক্রোফোন প্রয়োজন"
        }
      ]
    ],
    "scheme": "mindmate",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/382db31b-76ce-4111-a128-cbac82d9c901"
    },
    "extra": {
      "eas": {
        "projectId": "382db31b-76ce-4111-a128-cbac82d9c901"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "shafi261511s-team"
  }
}
